{
    "name": "chassisphp/chassisphp",
    "description": "The ChassisPHP Framework - A Framework for CMS Site Development",
    "keywords": [
        "framework",
        "CMS",
        "Chassis",
        "ChassisPHP"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Roger Creasy",
            "email": "roger@rogercreasy.com",
            "role": "Project Lead"
        }
    ],
    "type": "library",
    "require": {
        "php": "^8.3",
        "symfony/http-foundation": "^3.4.35",
        "symfony/http-kernel": "^3.3",
        "symfony/var-dumper": "^3.3",
        "league/container": "^3.3.0",
        "nikic/fast-route": "^1.2",
        "psr/http-message": "^2.0",
        "vlucas/phpdotenv": "^2.4",
        "doctrine/orm": "^2.5",
        "doctrine/cache": "1.11",
        "symfony/yaml": "^3.3",
        "monolog/monolog": "^2.0",
        "twig/twig": "^2.0",
        "laminas/laminas-diactoros": "^3.0",
        "symfony/validator": "^3.3",
        "phpmailer/phpmailer": "^6.5"
    },
    "config": {
        "allow-plugins": {
            "ocramius/package-versions": true,
            "composer/package-versions-deprecated": true
        },
        "policy": {
            "advisories": {
                "ignore": {
                    "symfony/http-foundation": "Unused by the framework; removed in deps-symfony-prune",
                    "symfony/http-kernel": "Unused by the framework; removed in deps-symfony-prune",
                    "symfony/validator": "Unused by the framework; removed in deps-symfony-prune",
                    "symfony/yaml": "Unused by the framework; removed in deps-symfony-prune",
                    "twig/twig": "Twig 2 has no fixed release; upgraded in deps-twig3"
                }
            }
        }
    },
    "autoload": {
        "files": [
            "src/Framework/helpers.php"
        ],
        "psr-4": {
            "ChassisPHP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs",
        "backup-sqlite": "\\Database\\Backup::run"
    },
    "extra": {
        "branch-alias": {
            "dev-0.7.x": "0.7.x-dev"
        }
    }
}
